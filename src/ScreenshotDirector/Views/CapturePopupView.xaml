<Window x:Class="ScreenshotDirector.Views.CapturePopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenshotDirector.Views"
        mc:Ignorable="d"
        Title="Screenshot Director"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Focusable="True"
        KeyDown="OnWindowKeyDown">

    <Window.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="WindowScale" ScaleX="1.0" ScaleY="1.0" CenterX="220" CenterY="140"/>
            <TranslateTransform x:Name="WindowTranslate" Y="0"/>
        </TransformGroup>
    </Window.RenderTransform>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                     From="0.0" To="1.0" 
                                     Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowTranslate" 
                                     Storyboard.TargetProperty="Y" 
                                     From="32" To="0" 
                                     Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                                     Storyboard.TargetProperty="ScaleX" 
                                     From="0.95" To="1.0" 
                                     Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                                     Storyboard.TargetProperty="ScaleY" 
                                     From="0.95" To="1.0" 
                                     Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisConverter"/>

        <!-- Modern Tile Card Button Style -->
        <Style x:Key="DestTileCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D2D35"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#272732"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#181820"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Glass Frame with Glow & Shadow -->
    <Border Background="#16161A" 
            BorderBrush="#0284C7" 
            BorderThickness="1.5" 
            CornerRadius="14" 
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" Direction="270" ShadowDepth="4" Opacity="0.8" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="14">
            <!-- ============================================== -->
            <!-- 1. COLLAPSED MINI-TOAST (Session Default Mode) -->
            <!-- ============================================== -->
            <Grid Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail -->
                    <Border Grid.Column="0" 
                            Width="64" Height="48" 
                            CornerRadius="6" 
                            BorderBrush="#0284C7" 
                            BorderThickness="1" 
                            Background="#09090B" 
                            ClipToBounds="True">
                        <Image Source="{Binding PreviewImage}" 
                               Stretch="UniformToFill" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>

                    <!-- Content & Actions -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="⚡ Auto-Routing to" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SessionDefaultFolderName, StringFormat=': {0}'}" 
                                       FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SessionDefaultPath}" 
                                   FontSize="10" Foreground="#A1A1AA" 
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="✓ Save Now" 
                                    Click="OnSaveSessionDefaultNowClick"
                                    Background="#0284C7" Foreground="#FFFFFF" 
                                    FontWeight="SemiBold" FontSize="11" 
                                    Padding="10,3" BorderThickness="0" 
                                    Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="🔽 Change / Expand" 
                                    Click="OnExpandToFullClick"
                                    Background="#27272A" Foreground="#E4E4E7" 
                                    FontSize="11" Padding="8,3" 
                                    BorderBrush="#3F3F46" BorderThickness="1" 
                                    Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="✕ Clear Default" 
                                    Click="OnClearSessionDefaultClick"
                                    Background="Transparent" Foreground="#F87171" 
                                    FontSize="10" Padding="4,3" 
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Timeout Bar -->
                <ProgressBar Grid.Row="1" 
                             Height="3" 
                             Minimum="0.0" 
                             Maximum="1.0" 
                             Value="{Binding TimeoutProgress, Mode=OneWay}" 
                             Foreground="#0284C7" 
                             Background="#222227" 
                             BorderThickness="0" 
                             Margin="0,10,0,0"/>
            </Grid>

            <!-- ============================================== -->
            <!-- 2. FULL EXPANDED POPUP (Normal Routing Mode)   -->
            <!-- ============================================== -->
            <Grid Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Preview & Filename Card -->
                    <RowDefinition Height="Auto"/> <!-- Error banner -->
                    <RowDefinition Height="Auto"/> <!-- Custom Path Confirmation Drawer -->
                    <RowDefinition Height="Auto"/> <!-- Destinations Grid -->
                    <RowDefinition Height="Auto"/> <!-- Session Default Checkbox & Footer -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📸" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Screenshot Director" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Foreground="#38BDF8"
                                   VerticalAlignment="Center"/>
                        <Border Background="#0C4A6E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Quick Route" FontSize="10" FontWeight="SemiBold" Foreground="#7DD3FC"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Select Path Button -->
                        <Button Content="📁 Select Path..." 
                                Click="OnSelectPathClick"
                                Background="#1E293B" 
                                Foreground="#38BDF8" 
                                BorderBrush="#0284C7" 
                                BorderThickness="1" 
                                FontSize="11" 
                                FontWeight="SemiBold"
                                Padding="8,3" 
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                ToolTip="Direct screenshot to another unlisted folder">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="✕" 
                                Click="OnDismissClick"
                                Foreground="#A1A1AA" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                FontSize="13" 
                                FontWeight="Bold"
                                Cursor="Hand"
                                ToolTip="Dismiss (Esc)"
                                Padding="6,2"/>
                    </StackPanel>
                </Grid>

                <!-- Preview & Filename Card -->
                <Border Grid.Row="1" Background="#1D1D22" BorderBrush="#2D2D35" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Column="0" 
                                Width="74" Height="54" 
                                CornerRadius="6" 
                                BorderBrush="#3E3E48" 
                                BorderThickness="1" 
                                Background="#09090B" 
                                ClipToBounds="True">
                            <Image Source="{Binding PreviewImage}" 
                                   Stretch="UniformToFill" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>

                        <!-- Filename Input with Placeholder & Resolution -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Filename:" Foreground="#A1A1AA" FontSize="11" FontWeight="Medium"/>
                                    <!-- Paused indicator when renaming -->
                                    <Border Background="#78350F" CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                            Visibility="{Binding IsTimerPaused, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="⏸ Paused" FontSize="9" FontWeight="Bold" Foreground="#FDE68A"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ResolutionText}" Foreground="#0284C7" FontSize="10" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Rename field with watermark -->
                            <Grid>
                                <!-- Watermark shown when text is empty -->
                                <TextBlock Text="{Binding DefaultFilename, StringFormat='(Default: {0})'}" 
                                           Foreground="#52525B" 
                                           FontSize="11" 
                                           VerticalAlignment="Center" 
                                           Margin="7,0,0,0" 
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Filename, Converter={StaticResource EmptyStringToVisConverter}}"/>

                                <TextBox x:Name="FilenameTextBox"
                                         Text="{Binding Filename, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         Foreground="#FFFFFF" 
                                         BorderBrush="#3E3E48" 
                                         BorderThickness="1" 
                                         Padding="6,4" 
                                         FontSize="12"
                                         CaretBrush="#38BDF8"
                                         GotFocus="OnFilenameGotFocus"
                                         KeyDown="OnFilenameKeyDown"
                                         TextChanged="OnFilenameTextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error Banner -->
                <Border Grid.Row="2" 
                        Background="#5C1A1A" 
                        BorderBrush="#FF5252" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="10,6" 
                        Margin="0,0,0,10"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="#FFD2D2" 
                               FontSize="11" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Custom Path Confirmation Drawer (when selected via Select Path) -->
                <Border Grid.Row="3" 
                        Background="#1E293B" 
                        BorderBrush="#0284C7" 
                        BorderThickness="1.5" 
                        CornerRadius="8" 
                        Padding="10" 
                        Margin="0,0,0,10"
                        Visibility="{Binding IsCustomPathSelected, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <TextBlock Text="📁 Selected Custom Folder:" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        <TextBlock Text="{Binding SelectedCustomPath}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>

                        <CheckBox IsChecked="{Binding AddCustomPathToPresets}" Margin="0,0,0,4">
                            <TextBlock Text="Add this folder to presets (assign shortcut key)" Foreground="#E4E4E7" FontSize="11"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding SetAsSessionDefaultOnSave}" Margin="0,0,0,8">
                            <TextBlock Text="Set as session default folder" Foreground="#E4E4E7" FontSize="11"/>
                        </CheckBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="✓ Save to Folder" 
                                    Click="OnConfirmSaveCustomPathClick"
                                    Background="#0284C7" Foreground="#FFFFFF" 
                                    FontWeight="Bold" FontSize="11" Padding="12,5" 
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="✕ Cancel" 
                                    Click="OnCancelCustomPathClick"
                                    Background="#27272A" Foreground="#A1A1AA" 
                                    FontSize="11" Padding="10,5" 
                                    BorderBrush="#3F3F46" BorderThickness="1" 
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Destinations 2-Column Tile Grid -->
                <ItemsControl Grid.Row="4" ItemsSource="{Binding Destinations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DestTileCardStyle}" 
                                    Click="OnDestinationClick"
                                    ToolTip="{Binding Path}"
                                    IsEnabled="{Binding DataContext.IsNotSaving, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Keycap Number Badge -->
                                    <Border Grid.Column="0" 
                                            Background="#0284C7" 
                                            BorderBrush="#38BDF8"
                                            BorderThickness="1"
                                            CornerRadius="5" 
                                            Width="24" Height="24" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ShortcutNumber}" 
                                                   Foreground="#FFFFFF" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Folder Info -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayIcon}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       Foreground="#FFFFFF" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12" 
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path}" 
                                                   Foreground="#A1A1AA" 
                                                   FontSize="10" 
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Session Default Toggle & Timeout Footer -->
                <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <!-- Session Default Checkbox -->
                    <CheckBox IsChecked="{Binding SetAsSessionDefaultOnSave}" Margin="2,0,0,8" ToolTip="Future screenshots in this session will auto-route to the selected folder">
                        <TextBlock Text="📌 Remember choice as session default folder" Foreground="#94A3B8" FontSize="11"/>
                    </CheckBox>

                    <!-- Timeout Bar -->
                    <ProgressBar Height="3.5" 
                                 Minimum="0.0" 
                                 Maximum="1.0" 
                                 Value="{Binding TimeoutProgress, Mode=OneWay}" 
                                 Foreground="#0284C7" 
                                 Background="#222227" 
                                 BorderThickness="0"/>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Press 1–9 or click tile to save" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Esc to dismiss" Foreground="#71717A" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
