<Window x:Class="ScreenshotDirector.Views.CapturePopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenshotDirector.ViewModels"
        mc:Ignorable="d"
        Title="Screenshot Director"
        Width="380" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Focusable="True"
        KeyDown="OnWindowKeyDown"
        MouseMove="OnWindowMouseMove">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <Style x:Key="DestButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E" 
            BorderBrush="#007ACC" 
            BorderThickness="1.5" 
            CornerRadius="10" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header / Title & Dismiss -->
                <RowDefinition Height="Auto"/> <!-- Preview & Filename -->
                <RowDefinition Height="Auto"/> <!-- Error / Status banner -->
                <RowDefinition Height="Auto"/> <!-- Destinations list -->
                <RowDefinition Height="Auto"/> <!-- Timeout bar -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📸 Screenshot Director" 
                               FontWeight="SemiBold" 
                               FontSize="13" 
                               Foreground="#00A2ED"/>
                </StackPanel>
                <Button Grid.Column="1" 
                        Content="✕" 
                        Click="OnDismissClick"
                        Foreground="#8E8E93" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        FontSize="12" 
                        Cursor="Hand"
                        ToolTip="Dismiss (Esc)"
                        Padding="6,2"/>
            </Grid>

            <!-- Preview & Filename -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Thumbnail -->
                <Border Grid.Column="0" 
                        Width="64" Height="48" 
                        CornerRadius="4" 
                        BorderBrush="#3E3E42" 
                        BorderThickness="1" 
                        Background="#252526" 
                        ClipToBounds="True">
                    <Image Source="{Binding PreviewImage}" 
                           Stretch="UniformToFill" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
                </Border>

                <!-- Filename Input -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="Filename:" 
                               Foreground="#A0A0A0" 
                               FontSize="11" 
                               Margin="0,0,0,2"/>
                    <TextBox x:Name="FilenameTextBox"
                             Text="{Binding Filename, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#2D2D30" 
                             Foreground="#FFFFFF" 
                             BorderBrush="#3E3E42" 
                             BorderThickness="1" 
                             Padding="6,4" 
                             FontSize="12"
                             CaretBrush="#FFFFFF"
                             KeyDown="OnFilenameKeyDown"
                             TextChanged="OnFilenameTextChanged"/>
                </StackPanel>
            </Grid>

            <!-- Error Banner -->
            <Border Grid.Row="2" 
                    Background="#5C1A1A" 
                    BorderBrush="#FF5252" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="8,5" 
                    Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#FFD2D2" 
                           FontSize="11" 
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Destinations List -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding Destinations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource DestButtonStyle}" 
                                Click="OnDestinationClick"
                                IsEnabled="{Binding DataContext.IsSaving, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Null}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Number Shortcut Badge -->
                                <Border Grid.Column="0" 
                                        Background="#007ACC" 
                                        CornerRadius="3" 
                                        Width="18" Height="18" 
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ShortcutNumber}" 
                                               Foreground="#FFFFFF" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Destination Name & Path -->
                                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" 
                                               Foreground="#FFFFFF" 
                                               FontWeight="Medium" 
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding Path}" 
                                               Foreground="#808080" 
                                               FontSize="10" 
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Save icon / hint -->
                                <TextBlock Grid.Column="2" 
                                           Text="Save" 
                                           Foreground="#606060" 
                                           FontSize="11" 
                                           VerticalAlignment="Center" 
                                           Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Status / Saving Indicator & Timeout Progress -->
            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <ProgressBar Height="3" 
                             Minimum="0.0" 
                             Maximum="1.0" 
                             Value="{Binding TimeoutProgress, Mode=OneWay}" 
                             Foreground="#007ACC" 
                             Background="#2D2D30" 
                             BorderThickness="0"/>
                <TextBlock Text="Press 1-9 to route, Esc to dismiss" 
                           Foreground="#606060" 
                           FontSize="10" 
                           HorizontalAlignment="Center" 
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
