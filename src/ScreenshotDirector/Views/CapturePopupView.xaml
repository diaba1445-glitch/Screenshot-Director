<Window x:Class="ScreenshotDirector.Views.CapturePopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenshotDirector.Views"
        mc:Ignorable="d"
        Title="Screenshot Director"
        Width="460" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Focusable="True"
        KeyDown="OnWindowKeyDown"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave">

    <Window.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="WindowScale" ScaleX="1.0" ScaleY="1.0" CenterX="230" CenterY="140"/>
            <TranslateTransform x:Name="WindowTranslate" Y="0"/>
        </TransformGroup>
    </Window.RenderTransform>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                     From="0.0" To="1.0" 
                                     Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowTranslate" 
                                     Storyboard.TargetProperty="Y" 
                                     From="28" To="0" 
                                     Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                                     Storyboard.TargetProperty="ScaleX" 
                                     From="0.96" To="1.0" 
                                     Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                                     Storyboard.TargetProperty="ScaleY" 
                                     From="0.96" To="1.0" 
                                     Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisConverter"/>

        <!-- Premium macOS Destination Tile Card Style -->
        <Style x:Key="DestTileCardStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#80191629"
                                BorderBrush="#2C2444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Light Glass Style Trigger -->
                            <DataTrigger Binding="{Binding DataContext.IsLightGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B3FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </DataTrigger>

                            <!-- Hover Dark Glass -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27213F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8B5CF6"/>
                            </Trigger>
                            <!-- Hover Light Glass -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.IsLightGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </MultiDataTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Pill Action Button Style -->
        <Style x:Key="HeaderPillButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#251E3D"
                                BorderBrush="#382E59"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsLightGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2F274E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.IsLightGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                    <Setter Property="Foreground" Value="#1E293B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLightGlass}" Value="False">
                    <Setter Property="Foreground" Value="#DDD6FE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer Glass Shell with Hardware Acrylic Backdrop & Ambient Shadow -->
    <Border x:Name="MainGlassBorder" CornerRadius="16" Margin="12">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#E612101F"/>
                <Setter Property="BorderBrush" Value="#3D345C"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="36" Direction="270" ShadowDepth="6" Opacity="0.80" Color="#000000"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                        <Setter Property="Background" Value="#E6F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="6" Opacity="0.25" Color="#0F172A"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="14">
            <!-- ============================================== -->
            <!-- 1. COLLAPSED MINI-TOAST (Session Default Mode) -->
            <!-- ============================================== -->
            <Grid Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail -->
                    <Border Grid.Column="0" 
                            Width="64" Height="48" 
                            CornerRadius="6" 
                            BorderThickness="1" 
                            ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#090810"/>
                                <Setter Property="BorderBrush" Value="#382E57"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding PreviewImage}" 
                               Stretch="UniformToFill" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>

                    <!-- Content & Actions -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="⚡ Auto-Routing to" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C084FC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SessionDefaultFolderName, StringFormat=': {0}'}" 
                                       FontSize="11" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding SessionDefaultPath}" 
                                   FontSize="10" 
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#8E8A9F"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="✓ Save Now" 
                                    Click="OnSaveSessionDefaultNowClick"
                                    FontWeight="SemiBold" FontSize="11" 
                                    Padding="10,4" BorderThickness="0" 
                                    Cursor="Hand" Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#7C3AED"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="🔽 Change / Expand" 
                                    Click="OnExpandToFullClick"
                                    FontSize="11" Padding="8,4" 
                                    BorderThickness="1" 
                                    Cursor="Hand" Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#221C35"/>
                                        <Setter Property="Foreground" Value="#DDD6FE"/>
                                        <Setter Property="BorderBrush" Value="#3B335A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                <Setter Property="Background" Value="#E2E8F0"/>
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="✕ Clear Default" 
                                    Click="OnClearSessionDefaultClick"
                                    Background="Transparent" Foreground="#F87171" 
                                    FontSize="10" Padding="4,4" 
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Timeout Bar -->
                <ProgressBar Grid.Row="1" 
                             Height="3" 
                             Minimum="0.0" 
                             Maximum="1.0" 
                             Value="{Binding TimeoutProgress, Mode=OneWay}" 
                             BorderThickness="0" 
                             Margin="0,10,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="#8B5CF6"/>
                            <Setter Property="Background" Value="#1F1A30"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>

            <!-- ============================================== -->
            <!-- 2. FULL EXPANDED POPUP (Normal Routing Mode)   -->
            <!-- ============================================== -->
            <Grid Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header with macOS Controls -->
                    <RowDefinition Height="Auto"/> <!-- Preview & Filename Card -->
                    <RowDefinition Height="Auto"/> <!-- Error banner -->
                    <RowDefinition Height="Auto"/> <!-- Custom Path Confirmation Drawer -->
                    <RowDefinition Height="Auto"/> <!-- Destinations Grid -->
                    <RowDefinition Height="Auto"/> <!-- Session Default Checkbox & Footer -->
                </Grid.RowDefinitions>

                <!-- Header Row: Clean Liquid Glass Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Camera Logo Badge & App Title & Mode Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Camera Logo Badge -->
                        <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                <GradientStop Color="#6366F1" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#3B82F6" Offset="0.0"/>
                                                        <GradientStop Color="#2563EB" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="📸" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Window Title -->
                        <TextBlock Text="Screenshot Director" FontWeight="Bold" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Mode Badge -->
                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#251E3C"/>
                                    <Setter Property="BorderBrush" Value="#3D3063"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Quick Route" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C084FC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Right: Select Path Pill & Clean Dismiss Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Select Path Pill -->
                        <Button Content="📁 Select Path..." 
                                Click="OnSelectPathClick"
                                Style="{StaticResource HeaderPillButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Direct screenshot to another unlisted folder"/>

                        <!-- Clean Dismiss '✕' Button -->
                        <Button Click="OnDismissClick"
                                ToolTip="Dismiss (Esc)"
                                Width="26" Height="26"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="closeBg" CornerRadius="13" Background="Transparent" Padding="4">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8E8A9F"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsLightGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="closeBg" Property="Background" Value="#33FF5F56"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Preview & Filename Card -->
                <Border Grid.Row="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#801A162B"/>
                            <Setter Property="BorderBrush" Value="#2D2545"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                    <Setter Property="Background" Value="#B3FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Column="0" 
                                Width="74" Height="52" 
                                CornerRadius="6" 
                                BorderThickness="1" 
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0A0910"/>
                                    <Setter Property="BorderBrush" Value="#382F57"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding PreviewImage}" 
                                   Stretch="UniformToFill" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>

                        <!-- Filename Input with Placeholder & Resolution -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Filename:" FontSize="11" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#8E8A9F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Paused indicator when renaming -->
                                    <Border Background="#3B2612" BorderBrush="#6B431D" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                            Visibility="{Binding IsTimerPaused, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="⏸ Paused" FontSize="9" FontWeight="Bold" Foreground="#FBBF24"/>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="5,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#241D3B"/>
                                            <Setter Property="BorderBrush" Value="#3A2D5C"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ResolutionText}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#C084FC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                        <Setter Property="Foreground" Value="#2563EB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <!-- Rename field with watermark -->
                            <Grid>
                                <!-- Watermark shown when text is empty -->
                                <TextBlock Text="{Binding DefaultFilename, StringFormat='(Default: {0})'}" 
                                           FontSize="11" 
                                           VerticalAlignment="Center" 
                                           Margin="7,0,0,0" 
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Filename, Converter={StaticResource EmptyStringToVisConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#5A5570"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBox x:Name="FilenameTextBox"
                                         Text="{Binding Filename, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="6,4" 
                                         FontSize="12"
                                         GotFocus="OnFilenameGotFocus"
                                         LostFocus="OnFilenameLostFocus"
                                         KeyDown="OnFilenameKeyDown"
                                         TextChanged="OnFilenameTextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="#100E19"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#342B50"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CaretBrush" Value="#A855F7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFFF"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                    <Setter Property="CaretBrush" Value="#2563EB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error Banner -->
                <Border Grid.Row="2" 
                        Background="#3B181E" 
                        BorderBrush="#7F1D1D" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="10,6" 
                        Margin="0,0,0,10"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="#FCA5A5" 
                               FontSize="11" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Custom Path Confirmation Drawer (when selected via Select Path) -->
                <Border Grid.Row="3" 
                        CornerRadius="8" 
                        Padding="12,10" 
                        Margin="0,0,0,10"
                        Visibility="{Binding IsCustomPathSelected, Converter={StaticResource BoolToVisConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#801A162B"/>
                            <Setter Property="BorderBrush" Value="#3D345C"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                    <Setter Property="Background" Value="#D8FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="📁 Selected Custom Folder:" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C084FC"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Foreground" Value="#2563EB"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedCustomPath}" FontWeight="Bold" FontSize="12" Margin="0,2,0,8" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <CheckBox IsChecked="{Binding AddCustomPathToPresets}" Margin="0,0,0,6">
                            <TextBlock Text="Add this folder to presets (assign shortcut key)" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DDD6FE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                <Setter Property="Foreground" Value="#334155"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding SetAsSessionDefaultOnSave}" Margin="0,0,0,10">
                            <TextBlock Text="Set as session default folder" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DDD6FE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                <Setter Property="Foreground" Value="#334155"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </CheckBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="✓ Save to Folder" 
                                    Click="OnConfirmSaveCustomPathClick"
                                    FontWeight="Bold" FontSize="11" Padding="12,5" 
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#7C3AED"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="✕ Cancel" 
                                    Click="OnCancelCustomPathClick"
                                    FontSize="11" Padding="10,5" 
                                    BorderThickness="1" 
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#241E38"/>
                                        <Setter Property="Foreground" Value="#8E8A9F"/>
                                        <Setter Property="BorderBrush" Value="#3A3059"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                                <Setter Property="Background" Value="#E2E8F0"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Destinations 2-Column Tile Grid -->
                <ItemsControl Grid.Row="4" ItemsSource="{Binding Destinations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DestTileCardStyle}" 
                                    Click="OnDestinationClick"
                                    ToolTip="{Binding Path}"
                                    IsEnabled="{Binding DataContext.IsNotSaving, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Keycap Number Badge -->
                                    <Border Grid.Column="0" 
                                            CornerRadius="6" 
                                            Width="24" Height="24" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                            <GradientStop Color="#6366F1" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsLightGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#3B82F6" Offset="0.0"/>
                                                                    <GradientStop Color="#2563EB" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ShortcutNumber}" 
                                                   Foreground="#FFFFFF" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Folder Info -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayIcon}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12" 
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsLightGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path}" 
                                                   FontSize="10" 
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8E8A9F"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsLightGlass, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Session Default Toggle & Timeout Footer -->
                <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <!-- Session Default Checkbox -->
                    <CheckBox IsChecked="{Binding SetAsSessionDefaultOnSave}" Margin="2,0,0,8" ToolTip="Future screenshots in this session will auto-route to the selected folder">
                        <TextBlock Text="📌 Remember choice as session default folder" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Foreground" Value="#475569"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </CheckBox>

                    <!-- Timeout Bar -->
                    <ProgressBar Height="3" 
                                 Minimum="0.0" 
                                 Maximum="1.0" 
                                 Value="{Binding TimeoutProgress, Mode=OneWay}" 
                                 BorderThickness="0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="#8B5CF6"/>
                                <Setter Property="Background" Value="#1F1A30"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                        <Setter Property="Foreground" Value="#3B82F6"/>
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Press 1–9 or click tile to save" FontSize="11" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#8E8A9F"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="Esc to dismiss" FontSize="11" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#5A5570"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightGlass}" Value="True">
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
