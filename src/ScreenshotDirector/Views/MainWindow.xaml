<Window x:Class="ScreenshotDirector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenshotDirector.ViewModels"
        mc:Ignorable="d"
        Title="Screenshot Director — Control Center" 
        Height="640" Width="800"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#121214" 
        Foreground="#F4F4F5"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Custom Dark ScrollBar and Control Styles -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F1F23"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0098FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#52525B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D1515"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#991B1B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition MinWidth="28" Width="28"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="ToggleButton"
                              Grid.ColumnSpan="2"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="tbBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Fill="#38BDF8"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tbBorder" Property="BorderBrush" Value="#0284C7"/>
                                    <Setter TargetName="tbBorder" Property="Background" Value="#25252D"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="tbBorder" Property="BorderBrush" Value="#38BDF8"/>
                                    <Setter TargetName="tbBorder" Property="Background" Value="#22222A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="10,5,28,5"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>

                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       PopupAnimation="Slide">
                    <Border x:Name="DropDownBorder"
                            Background="#18181B"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="5"
                            MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            Margin="0,2,0,0">
                        <ScrollViewer SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0C4A6E"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="lbBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="lbBorder" Property="Background" Value="#222227"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="lbBorder" Property="Background" Value="#172554"/>
                                <Setter TargetName="lbBorder" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top App Header & Live Status -->
            <RowDefinition Height="Auto"/> <!-- Onboarding Banner (if first run) -->
            <RowDefinition Height="*"/>    <!-- Tabs / Main Configuration -->
            <RowDefinition Height="Auto"/> <!-- Bottom Action & Status Footer -->
        </Grid.RowDefinitions>

        <!-- Top Header & Live Status -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📸" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Screenshot Director" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" BorderBrush="#0369A1" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="Control Center" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Instant screenshot routing to custom preset folders (Keys 1–9) with lossless PNG encoding." 
                           FontSize="12" Foreground="#A1A1AA" Margin="32,2,0,0"/>
            </StackPanel>

            <!-- Status Badge & Control Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Status Badge -->
                <Border Background="#1C1917" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding DetectionStatusBadgeColor}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding DetectionStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="#F4F4F5"/>
                    </StackPanel>
                </Border>

                <!-- Pause / Resume Toggle -->
                <Button Content="{Binding PauseResumeButtonText}" Click="OnTogglePauseClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>

                <!-- Stop Program -->
                <Button Content="🛑 Stop Program" Click="OnStopProgramClick" Style="{StaticResource DangerButtonStyle}" ToolTip="Completely stops the background listener and exits"/>
            </StackPanel>
        </Grid>

        <!-- Onboarding / Welcome Setup Banner (shown when first run or no presets) -->
        <Border Grid.Row="1" 
                Visibility="{Binding ShowOnboardingGuide, Converter={StaticResource BoolToVisConverter}}"
                Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="👋 Welcome! Configure your screenshot destination presets" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                    <TextBlock Text="When you press Win+Shift+S or PrtScn, a routing popup appears near your cursor mapping your folders to keys 1–9. Customize your preset folders below to get started!" 
                               FontSize="12" Foreground="#CBD5E1" Margin="0,3,0,6" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Quick Templates:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="+ Screenshots" Click="OnAddTemplateScreenshotsClick" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="+ Desktop" Click="OnAddTemplateDesktopClick" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="+ Downloads" Click="OnAddTemplateDownloadsClick" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✓ Confirm &amp; Activate Presets" Click="OnSaveClick" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">

            <!-- TAB 1: Preset Folders -->
            <TabItem Header="📁 Preset Folders (Keys 1–9)">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Description bar -->
                        <RowDefinition Height="*"/>    <!-- Presets list & tools -->
                        <RowDefinition Height="Auto"/> <!-- Edit selected form -->
                    </Grid.RowDefinitions>

                    <!-- Header & Summary -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DestinationsCountSummary}" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8"/>
                            <TextBlock Text="Pressing 1 saves to Destination 1, 2 to Destination 2, etc. Drag or move up/down to reorder." FontSize="11" Foreground="#A1A1AA"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🧪 Test Capture Popup" Click="OnTestPopupClick" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Preview the routing popup near your cursor with these presets"/>
                    </Grid>

                    <!-- Presets List & Controls -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <!-- Presets ListBox -->
                        <ListBox Grid.Column="0" 
                                 ItemsSource="{Binding Destinations}" 
                                 SelectedItem="{Binding SelectedDestination}"
                                 Background="#121214" 
                                 BorderBrush="#27272A" 
                                 Margin="0,0,10,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Badge 1-9 -->
                                        <Border Grid.Column="0" Background="#007ACC" CornerRadius="4" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortcutNumber}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name & Path -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F4F4F5" FontSize="13"/>
                                            <TextBlock Text="{Binding Path}" Foreground="#71717A" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Checkbox Enabled -->
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" ToolTip="Include this preset in capture popup" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Presets Side Actions -->
                        <StackPanel Grid.Column="1">
                            <Button Content="➕ Add Folder" Click="OnAddCustomDestinationClick" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,6"/>
                            <Button Content="📂 Browse Folder..." Click="OnBrowseNewDestinationClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6"/>
                            <Button Content="🗑 Remove" Click="OnRemoveDestinationClick" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,10"/>

                            <Separator Background="#27272A" Margin="0,0,0,10"/>

                            <Button Content="▲ Move Up" Click="OnMoveUpClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" ToolTip="Move up (advances shortcut number)"/>
                            <Button Content="▼ Move Down" Click="OnMoveDownClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" ToolTip="Move down"/>
                        </StackPanel>
                    </Grid>

                    <!-- Edit Selected Preset Form -->
                    <Border Grid.Row="2" Background="#1F1F23" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset Name:" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="#D4D4D8" FontSize="12"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDestination.Name, UpdateSourceTrigger=PropertyChanged}" Background="#121214" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,8,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder Path:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#D4D4D8" FontSize="12"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDestination.Path, UpdateSourceTrigger=PropertyChanged}" Background="#121214" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,8,0"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="OnBrowsePathClick" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Permissions & System Status -->
            <TabItem Header="🛡️ Permissions &amp; System">
                <StackPanel Margin="18">
                    <!-- Native Clipboard Permission -->
                    <Border Background="#1F1F23" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Native Clipboard Format Listener" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                <TextBlock Text="Listens for native Windows WM_CLIPBOARDUPDATE messages. Never records text, passwords, or personal data." Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="🟢 Granted &amp; Active" FontWeight="SemiBold" FontSize="11" Foreground="#34D399"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Windows Startup Registration -->
                    <Border Background="#1F1F23" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Start automatically with Windows" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                        <TextBlock Text="Launches minimized to tray on user login (HKCU Run key, no admin privileges required)." Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StartupPermissionText}" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- System Tray Minimization -->
                    <Border Background="#1F1F23" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <CheckBox IsChecked="{Binding RunInSystemTray}">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Keep active in system tray when window is closed" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                <TextBlock Text="Closing this window will hide it to the system tray so screenshots can still be routed. To exit completely, click 'Stop Program'." Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- Single Instance Lock -->
                    <Border Background="#1F1F23" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Single-Instance Mutex Enforcement" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                <TextBlock Text="Prevents multiple conflicting background instances. Launching a second instance signals and activates this window." Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="🟢 Mutex Acquired" FontWeight="SemiBold" FontSize="11" Foreground="#34D399"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- TAB 3: Routing & Detection Preferences -->
            <TabItem Header="⚙️ Routing &amp; Preferences">
                <StackPanel Margin="18">
                    <!-- Copy Path Checkbox -->
                    <CheckBox IsChecked="{Binding CopySavedPathToClipboard}" Margin="0,0,0,14">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Copy saved file path to clipboard" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                            <TextBlock Text="Places the absolute file path on the clipboard ready to paste into Slack, Discord, or browser." Foreground="#A1A1AA" FontSize="11"/>
                        </StackPanel>
                    </CheckBox>

                    <!-- Quick Rename Checkbox -->
                    <CheckBox IsChecked="{Binding AllowQuickRename}" Margin="0,0,0,14">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Allow quick filename renaming in popup" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                            <TextBlock Text="Displays an editable filename field in the routing popup." Foreground="#A1A1AA" FontSize="11"/>
                        </StackPanel>
                    </CheckBox>

                    <!-- Popup Timeout -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Popup auto-dismiss timeout (seconds):" Foreground="#F4F4F5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding PopupTimeoutSeconds}" Background="#121214" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="(1–60 seconds, auto-pauses when renaming filename)" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Popup Screen Position -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Popup Screen Position:" Foreground="#F4F4F5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding AvailablePopupPositions}" 
                                  SelectedItem="{Binding PopupPosition}"
                                  Padding="6,4"/>
                        <TextBlock Grid.Column="2" Text="(Fixed toast at BottomRight, TopRight, BottomCenter, or CursorAdjacent)" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Active Session Default Folder -->
                    <Border Background="#1C1C22" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📌 Session Default Folder (Quick-Route)" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    <Border Background="#0C4A6E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasSessionDefault, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Active" FontSize="10" FontWeight="SemiBold" Foreground="#7DD3FC"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SessionDefaultDisplayPath}" Foreground="#F4F4F5" FontSize="12" Margin="0,4,0,2" FontWeight="Medium"/>
                                <TextBlock Text="When set, screenshots auto-route with a quick collapsed toast (3s) so you aren't asked every time. Click Expand in the toast for exceptions." 
                                           Foreground="#A1A1AA" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Content="📂 Set Folder..." Click="OnSetSessionDefaultClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="✕ Clear" Click="OnClearSessionDefaultClick" Style="{StaticResource DangerButtonStyle}" IsEnabled="{Binding HasSessionDefault}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Filename Template -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Default Filename Pattern:" Foreground="#F4F4F5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DefaultFilenamePattern}" Background="#121214" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="6,4" Width="380" HorizontalAlignment="Left"/>
                        <TextBlock Text="Format supports timestamp template: Screenshot_yyyy-MM-dd_HH-mm-ss.png" Foreground="#71717A" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Detection Policy -->
                    <Border Background="#1F1F23" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Detection Policy &amp; Web Filtering" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            <TextBlock Text="By default (Conservative Mode), browser image copies (Right click -> Copy Image) and Office embeddings are filtered to prevent accidental popups." 
                                       Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <CheckBox IsChecked="{Binding GenericImageFallbackEnabled}">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Enable Generic Image Fallback" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Also route general images copied from external image viewers or graphic software." Foreground="#71717A" FontSize="11"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Bottom Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status message -->
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <!-- Action buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🧪 Test Popup" Click="OnTestPopupClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="💾 Save &amp; Apply" Click="OnSaveClick" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Minimize to Tray" Click="OnMinimizeToTrayClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="🛑 Stop Program" Click="OnStopProgramClick" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
