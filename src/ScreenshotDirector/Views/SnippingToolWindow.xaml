<Window x:Class="ScreenshotDirector.Views.SnippingToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenshotDirector.Views"
        mc:Ignorable="d"
        Title="Screenshot Director — Snipping &amp; Markup Tool"
        Icon="pack://application:,,,/ScreenshotDirector;component/Assets/app.ico"
        Height="780" Width="1160"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0E0D13"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI"
        KeyDown="OnWindowKeyDown"
        SizeChanged="OnWindowSizeChanged"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>

        <!-- Tool Toggle Button Style -->
        <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#241E38"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#A855F7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Header Button Style (Secondary) -->
        <Style x:Key="HeaderSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1A2E"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#2F2848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E2848"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4C4270"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#171324"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="HeaderPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark dropdown list item ("Save to..." menu entries) -->
        <Style x:Key="DarkMenuSubItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3B2A63"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark dropdown header ("Save to..." button + popup frame) -->
        <Style x:Key="DarkMenuTopLevelStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Background" Value="#1E1A2E"/>
            <Setter Property="BorderBrush" Value="#2F2848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="#1E1A2E"
                                        BorderBrush="#3B325E"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4"
                                        MinWidth="190">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
                                    </Border.Effect>
                                    <ItemsPresenter Grid.IsSharedSizeScope="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#2E2848"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#4C4270"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#2E2848"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#A855F7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Header & Actions -->
            <RowDefinition Height="Auto"/> <!-- Editing Tools & Palette -->
            <RowDefinition Height="*"/>    <!-- Canvas Area -->
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#151222" BorderBrush="#26203B" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Identity & Resolution Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/ScreenshotDirector;component/Assets/app.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Snipping &amp; Markup Tool" FontSize="14" FontWeight="Bold" Foreground="#F4F4F5" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Border Background="#251F3D" BorderBrush="#3B325E" BorderThickness="1" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResolutionText}" FontSize="11" FontWeight="Medium" Foreground="#C084FC"/>
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Quick Save To Dropdown / Menu -->
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,4,0">
                        <MenuItem Header="📁 Save to..."
                                  Style="{StaticResource DarkMenuTopLevelStyle}"
                                  ItemsSource="{Binding Destinations}">
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Padding="4,2"/>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuSubItemStyle}">
                                    <EventSetter Event="Click" Handler="OnQuickSaveDestinationClick"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>

                    <!-- Save As Button -->
                    <Button Content="💾 Save As..." Style="{StaticResource HeaderSecondaryButtonStyle}" Click="OnSaveAsClick" ToolTip="Save image to custom location (Ctrl+S)"/>

                    <!-- Copy Button -->
                    <Button Content="📋 Copy" Style="{StaticResource HeaderSecondaryButtonStyle}" Click="OnCopyClick" ToolTip="Copy edited image to clipboard (Ctrl+C)"/>

                    <!-- Apply to Popup Button -->
                    <Button Content="🚀 Apply to Popup (1-9)" Style="{StaticResource HeaderPrimaryButtonStyle}" Click="OnApplyToPopupClick" ToolTip="Apply changes back to the popup to route via destination folders 1-9 (Enter)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Editing Toolbar -->
        <Border Grid.Row="1" Background="#100E1A" BorderBrush="#201B30" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tools & Styles Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Snip / Crop Tool -->
                    <RadioButton Content="✂️ Snip" Style="{StaticResource ToolButtonStyle}" IsChecked="{Binding IsSelectMode, Mode=OneWay}" Click="OnSelectModeClick" ToolTip="Crop / Select Area (1)"/>
                    <RadioButton Content="✏️ Pen" Style="{StaticResource ToolButtonStyle}" IsChecked="{Binding IsPenMode, Mode=OneWay}" Click="OnPenModeClick" ToolTip="Freehand Pen (2)"/>
                    <RadioButton Content="🖌️ Highlighter" Style="{StaticResource ToolButtonStyle}" IsChecked="{Binding IsHighlighterMode, Mode=OneWay}" Click="OnHighlighterModeClick" ToolTip="Highlighter (3)"/>
                    <RadioButton Content="➡️ Arrow" Style="{StaticResource ToolButtonStyle}" IsChecked="{Binding IsArrowMode, Mode=OneWay}" Click="OnArrowModeClick" ToolTip="Arrow (4)"/>
                    <RadioButton Content="⬜ Rect" Style="{StaticResource ToolButtonStyle}" IsChecked="{Binding IsRectangleMode, Mode=OneWay}" Click="OnRectangleModeClick" ToolTip="Rectangle Box (5)"/>
                    <RadioButton Content="⭕ Ellipse" Style="{StaticResource ToolButtonStyle}" IsChecked="{Binding IsEllipseMode, Mode=OneWay}" Click="OnEllipseModeClick" ToolTip="Ellipse / Circle (6)"/>
                    <RadioButton Content="🔤 Text" Style="{StaticResource ToolButtonStyle}" IsChecked="{Binding IsTextMode, Mode=OneWay}" Click="OnTextModeClick" ToolTip="Add Text Note (7)"/>
                    <RadioButton Content="⬛ Redact" Style="{StaticResource ToolButtonStyle}" IsChecked="{Binding IsPixelateMode, Mode=OneWay}" Click="OnPixelateModeClick" ToolTip="Blur / Redact Sensitive Area (8)"/>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="22" Fill="#28223D" Margin="8,0"/>

                    <!-- Stroke Thickness -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Stroke:" FontSize="11" Foreground="#8B86A2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="2px" Style="{StaticResource HeaderSecondaryButtonStyle}" Padding="6,3" FontSize="11" Click="OnThickness2Click" ToolTip="Fine Line"/>
                        <Button Content="4px" Style="{StaticResource HeaderSecondaryButtonStyle}" Padding="6,3" FontSize="11" Click="OnThickness4Click" ToolTip="Medium Line"/>
                        <Button Content="8px" Style="{StaticResource HeaderSecondaryButtonStyle}" Padding="6,3" FontSize="11" Click="OnThickness8Click" ToolTip="Thick Line"/>
                        <Button Content="14px" Style="{StaticResource HeaderSecondaryButtonStyle}" Padding="6,3" FontSize="11" Click="OnThickness14Click" ToolTip="Heavy Line"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="22" Fill="#28223D" Margin="8,0"/>

                    <!-- Color Swatches -->
                    <ItemsControl ItemsSource="{Binding AvailableColors}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="24" Height="24" Margin="1,0" Cursor="Hand"
                                        Click="OnColorSwatchClick"
                                        ToolTip="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <!-- Outer ring shows the active selection -->
                                                <Border x:Name="SelectionRing"
                                                        Width="24" Height="24"
                                                        CornerRadius="12"
                                                        BorderThickness="2"
                                                        BorderBrush="Transparent"/>
                                                <Border x:Name="ColorCircle"
                                                        Width="18" Height="18"
                                                        CornerRadius="9"
                                                        Background="{Binding Hex}"
                                                        BorderBrush="#40FFFFFF"
                                                        BorderThickness="1"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#99FFFFFF"/>
                                                </Trigger>
                                                <!-- Declared after hover so the selected ring always wins -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#A855F7"/>
                                                    <Setter TargetName="ColorCircle" Property="BorderBrush" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Undo / Redo & Zoom Controls Right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↩ Undo" Style="{StaticResource HeaderSecondaryButtonStyle}" IsEnabled="{Binding CanUndo}" Click="OnUndoClick" ToolTip="Undo (Ctrl+Z)"/>
                    <Button Content="↪ Redo" Style="{StaticResource HeaderSecondaryButtonStyle}" IsEnabled="{Binding CanRedo}" Click="OnRedoClick" ToolTip="Redo (Ctrl+Y)"/>
                    <Button Content="↺ Reset" Style="{StaticResource HeaderSecondaryButtonStyle}" Click="OnResetClick" ToolTip="Revert to original screenshot"/>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="22" Fill="#28223D" Margin="8,0"/>

                    <!-- Zoom Controls -->
                    <Button Content="-" Style="{StaticResource HeaderSecondaryButtonStyle}" Padding="8,4" Click="OnZoomOutClick" ToolTip="Zoom Out"/>
                    <TextBlock Text="{Binding ZoomPercentageText}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="4,0" MinWidth="34" TextAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource HeaderSecondaryButtonStyle}" Padding="8,4" Click="OnZoomInClick" ToolTip="Zoom In"/>
                    <Button Content="100%" Style="{StaticResource HeaderSecondaryButtonStyle}" Padding="6,4" FontSize="11" Click="OnZoom100Click" ToolTip="Actual Size"/>
                    <Button Content="Fit" Style="{StaticResource HeaderSecondaryButtonStyle}" Padding="6,4" FontSize="11" Click="OnZoomFitClick" ToolTip="Fit to window"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Canvas Working Area -->
        <ScrollViewer x:Name="CanvasScrollViewer"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#0A0812"
                      PreviewMouseWheel="OnCanvasMouseWheel">
            <!-- Plain host + LayoutTransform (no Viewbox) so the ScrollViewer's
                 extent matches the zoomed size exactly and scrolling can follow the cursor. -->
            <Border x:Name="CanvasScaleHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="CanvasScale"
                                    ScaleX="{Binding ZoomScale}"
                                    ScaleY="{Binding ZoomScale}"
                                    CenterX="0" CenterY="0"/>
                </Border.LayoutTransform>

                <!-- Drop Shadow & Border for Screenshot Canvas -->
                <Border BorderBrush="#251E38" BorderThickness="1" CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                    </Border.Effect>

                    <Grid x:Name="CanvasHostGrid">
                        <!-- Underlying Screenshot Image -->
                        <Image x:Name="ScreenshotImage" 
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Interactive Annotation Overlay Canvas -->
                        <local:AnnotationCanvas x:Name="OverlayCanvas"
                                               ViewModel="{Binding}"
                                               CropRectChanged="OnCropRectChanged"/>
                    </Grid>
                </Border>
            </Border>
        </ScrollViewer>

        <!-- Floating Crop Control Bar (Appears when Crop area is selected) -->
        <Border x:Name="FloatingCropBar"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Background="#1D182E"
                BorderBrush="#3D325E"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CropDimensionsText" Text="Crop: 0 × 0" FontSize="12" FontWeight="SemiBold" Foreground="#C084FC" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Content="✓ Apply Crop (Enter)" Style="{StaticResource HeaderPrimaryButtonStyle}" Padding="12,5" Click="OnConfirmCropClick"/>
                <Button Content="✕ Cancel (Esc)" Style="{StaticResource HeaderSecondaryButtonStyle}" Padding="10,5" Click="OnCancelCropClick"/>
            </StackPanel>
        </Border>

        <!-- Floating Toast Notification Banner -->
        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Background="#181326"
                BorderBrush="#7C3AED"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16,8"
                Visibility="{Binding IsStatusMessageVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.4"/>
            </Border.Effect>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
        </Border>
    </Grid>
</Window>
